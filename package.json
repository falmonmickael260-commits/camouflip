{
  "name": "maison-masquee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "start": "node --import tsx server/index.ts",
    "server": "tsx watch server/index.ts",
    "server:once": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "test:network": "node --import tsx tests/network-check.ts",
    "test:match": "node --import tsx tests/match-check.ts",
    "test:taunt": "node --import tsx tests/taunt-network-check.ts",
    "test:platform": "node --import tsx tests/platform-integration-check.ts",
    "test:desktop-taunt": "node tests/desktop-taunt-check.mjs",
    "test:production": "node tests/production-check.mjs",
    "test:browser": "node tests/browser-controls.mjs"
  },
  "dependencies": {
    "three": "0.186.1",
    "tsx": "4.23.15",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "playwright-core": "^1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
